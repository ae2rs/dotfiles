# Added by `devbox configure-ssh`
Include ~/.namespace/ssh/*.ssh

# Tailscale.app stays on amo.co, which also routes 10.1.0.0/16: home hosts go through the
# home tailnet's own tailscaled (launchd onl.factory.tailscale-home), SOCKS5 on 1055.
Host little-boy
  HostName 10.1.20.2

Host little-boy 10.1.* *.home.arpa
  User ae2rs
  ProxyCommand nc -X 5 -x 127.0.0.1:1055 %h %p
